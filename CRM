function resetForm() {
  document.getElementById('form-body').style.display='';
  document.getElementById('success-screen').style.display='none';
  document.querySelector('.submit-bar').style.display='';
  ['lead-blocks','contact-blocks','agenda-blocks','new-iss-blocks'].forEach(id=>{
    document.getElementById(id).innerHTML='';
  });
  document.getElementById('wa-list').innerHTML='<div class="no-issues">Add tomorrow\'s plans above to generate messages…</div>';
  leadCount=contCount=agendaCount=issCount=0;
  issueActions={}; pendingLeads=[];
  document.getElementById('followup-wrap').classList.add('hidden');
  document.getElementById('submit-btn').disabled=false;
  document.getElementById('submit-status').textContent=crmUser;
  loadIssues();
  loadPendingLeads();
}

function toast(msg,dur=2500){
  const t=document.getElementById('toast');
  t.textContent=msg; t.style.display='block';
  setTimeout(()=>t.style.display='none',dur);
}

window.addEventListener('DOMContentLoaded',()=>{
  document.getElementById('f-date').value=new Date().toISOString().substring(0,10);
});
