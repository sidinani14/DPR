        <div class="val-btn" id="lbv-v-${id}" onclick="setLeadVal(${id},'Valid')">✓ Valid</div>
        <div class="val-btn" id="lbv-i-${id}" onclick="setLeadVal(${id},'Invalid')">✗ Invalid</div>
      </div>
      <input type="hidden" id="lb-val-${id}" value="Not checked">
    </div>
    <div class="field">
      <span class="lbl">Lead Status</span>
      <div class="status-grid" id="lb-statgrid-${id}">
        ${LEAD_STATUSES.map(s=>`
          <div class="status-pill" data-key="${s.key}"
            style="background:${s.bg};color:${s.color};border-color:${s.bg}"
            onclick="setLeadStatus(${id},'${s.key.replace(/'/g,"\\'")}')">
            ${s.key}
          </div>`).join('')}
      </div>
      <input type="hidden" id="lb-status-${id}" value="Not Contacted">
    </div>
    <div class="field-row">
      <div class="field">
        <span class="lbl">Lead Manager</span>
        <select id="lb-mgr-${id}">
          <option value="">Select…</option>${mgrOpts}
        </select>
      </div>
    </div>
    <div class="field">
      <span class="lbl">Remarks</span>
      <textarea id="lb-remarks-${id}" placeholder="Project type, requirements, notes…" style="min-height:48px"></textarea>
    </div>
