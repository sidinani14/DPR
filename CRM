    <div class="field">
      <span class="lbl">Agenda Points</span>
      <textarea id="ag-agenda-${id}" oninput="generateAllWA()" placeholder="• Review design drawings\n• Discuss material finalization\n• Address pending approvals…" style="min-height:70px"></textarea>
    </div>
    <div class="field">
      <span class="lbl">Attendees</span>
      <input type="text" id="ag-attendees-${id}" oninput="generateAllWA()" placeholder="Client name, Siddharth sir, Achal, site team…">
    </div>`;
  document.getElementById('agenda-blocks').appendChild(div);
  generateAllWA();
}

function setAgendaType(id, type) {
  document.getElementById('ag-type-'+id).value=type;
  document.getElementById('ab-tmtg-'+id).className='type-btn'+(type==='Meeting'?' on-mtg':'');
  document.getElementById('ab-tvis-'+id).className='type-btn'+(type==='Site Visit'?' on-visit':'');
  generateAllWA();
}

function buildAgendaWA(id) {
  const proj      = document.getElementById('ag-proj-'+id)?.value||'[Project]';
  const type      = document.getElementById('ag-type-'+id)?.value||'Meeting';
  const dateVal   = document.getElementById('ag-date-'+id)?.value||'';
  const time      = document.getElementById('ag-time-'+id)?.value||'';
  const agendaTxt = document.getElementById('ag-agenda-'+id)?.value?.trim()||'';
  const attendees = document.getElementById('ag-attendees-'+id)?.value?.trim()||'';
  const emoji     = type==='Meeting'?'👥':'🏗️';
  const dFormatted= dateVal
    ? new Date(dateVal+'T12:00:00').toLocaleDateString('en-IN',{weekday:'long',day:'2-digit',month:'short',year:'numeric'})
    : '[Date]';

  let msg=`${emoji} *${type} Agenda — ${proj}*\n\n`;
  msg+=`📆 *Date:* ${dFormatted}\n`;
  msg+=`🕐 *Time:* ${time||'[Time]'}\n`;
  msg+=`📍 *Type:* ${type}\n\n`;
  if(agendaTxt){ msg+=`*Agenda:*\n${agendaTxt}\n\n`; }
  if(attendees){
    msg+=`*Attendees:*\n`;
    attendees.split(',').map(a=>a.trim()).filter(Boolean).forEach(a=>{ msg+=`• ${a}\n`; });
    msg+='\n';
  }
  msg+=`Please confirm your availability.\n\n— Ideaform Design Studio\nCRM: ${crmUser||'Aman Raghuwanshi'}`;
  return msg;
}

function generateAllWA() {
  const blocks=document.querySelectorAll('.agenda-block');
  const c=document.getElementById('wa-list');
  if(!blocks.length){
    c.innerHTML='<div class="no-issues">Add tomorrow\'s plans above to generate messages…</div>';
    return;
  }
  c.innerHTML=[...blocks].map(b=>{
    const id=b.id.replace('ab-','');
    const proj=document.getElementById('ag-proj-'+id)?.value||'Project';
    const type=document.getElementById('ag-type-'+id)?.value||'Meeting';
    const msg=buildAgendaWA(id);
    return `<div class="wa-block">
      <div class="wa-proj-name">${type==='Meeting'?'👥':'🏗️'} ${proj} — ${type}</div>
      <textarea class="wa-textarea" id="wa-${id}" readonly onclick="this.select()">${msg}</textarea>
      <button class="copy-btn-sm" onclick="copyWA('wa-${id}')">📋 Copy &amp; Send to Group</button>
    </div>`;
  }).join('');
}

function copyWA(id){
  const ta=document.getElementById(id);
  navigator.clipboard.writeText(ta.value)
    .then(()=>toast('Copied!'))
    .catch(()=>{ ta.select(); document.execCommand('copy'); toast('Copied!'); });
}

