<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>IDS · CRM Daily Report</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F5F3EE;--surface:#FFFFFF;--surface2:#F9F8F5;--border:#E2DFD8;--border2:#CBC7BC;
  --text:#1A1917;--text2:#6B6860;--text3:#9E9B94;
  --accent:#1F3A5F;--accent-light:#E8EEF5;
  --green:#1B7A3E;--green-bg:#E8F5EE;
  --amber:#7A5000;--amber-bg:#FFF8E1;
  --red:#8B2020;--red-bg:#FFEBEE;
  --blue:#1565C0;--blue-bg:#E3F2FD;
  --teal:#005F73;--teal-bg:#E0F7FA;
  --radius:12px;--radius-sm:8px;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding-bottom:100px;}

.header{background:var(--accent);padding:14px 18px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:100;}
.header-title{color:rgba(255,255,255,0.9);font-size:13px;font-weight:600;}
.header-title span{color:#F5A623;}
.user-pill{background:rgba(255,255,255,0.15);border-radius:20px;padding:5px 12px;font-size:12px;color:#fff;display:flex;align-items:center;gap:6px;margin-left:auto;}
.user-dot{width:8px;height:8px;border-radius:50%;background:#2ED573;}

.form-wrap{max-width:660px;margin:0 auto;padding:14px;}
.section{background:var(--surface);border-radius:var(--radius);margin-bottom:14px;overflow:hidden;border:1px solid var(--border);}
.section-head{background:var(--accent);padding:12px 18px;display:flex;align-items:center;gap:10px;}
.section-num{width:22px;height:22px;border-radius:50%;background:rgba(245,166,35,0.3);color:#F5A623;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.section-title{color:#fff;font-size:13px;font-weight:600;flex:1;}
.section-badge{background:rgba(234,67,53,0.3);color:#FF8A80;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;}
.section-body{padding:16px 18px;}

.field{margin-bottom:12px;}
.field:last-child{margin-bottom:0;}
.lbl{font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;margin-bottom:5px;display:block;}
.opt{font-size:10px;color:var(--text3);font-weight:400;text-transform:none;letter-spacing:0;}
input[type=text],input[type=date],input[type=number],input[type=time],select,textarea{
  width:100%;padding:9px 12px;background:var(--surface2);border:1.5px solid var(--border);
  border-radius:var(--radius-sm);font-family:inherit;font-size:13px;color:var(--text);outline:none;transition:border-color .15s;
}
input[type=number]{-moz-appearance:textfield;}
input[type=number]::-webkit-outer-spin-button,input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;}
input:focus,select:focus,textarea:focus{border-color:var(--accent);}
textarea{min-height:62px;resize:vertical;}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;}
.field-row .field{margin-bottom:0;}
.field-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px;}

/* Chips */
.chips{display:flex;flex-wrap:wrap;gap:6px;}
.chip{padding:5px 11px;border-radius:20px;font-size:12px;font-weight:500;cursor:pointer;border:1.5px solid var(--border);background:var(--surface2);color:var(--text2);transition:all .15s;user-select:none;}
.chip.on{background:var(--accent);border-color:var(--accent);color:#fff;}

/* YN buttons */
.yn-btns{display:grid;grid-template-columns:1fr 1fr;gap:7px;max-width:170px;}
.yn-btn{padding:7px;border-radius:var(--radius-sm);font-size:12px;font-weight:600;cursor:pointer;border:1.5px solid var(--border);background:var(--surface2);color:var(--text2);text-align:center;}
.yn-btn.on-yes{background:var(--green-bg);border-color:var(--green);color:var(--green);}
.yn-btn.on-no{background:var(--surface2);border-color:var(--border2);color:var(--text3);}

/* Lead blocks */
.lead-block{background:var(--surface2);border:2px solid var(--blue);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px;}
.lb-header{display:flex;align-items:center;gap:10px;margin-bottom:13px;}
.lb-num{background:var(--blue);color:#fff;font-size:11px;font-weight:700;padding:3px 11px;border-radius:11px;flex-shrink:0;}
.lb-name-display{font-size:12px;color:var(--text2);flex:1;font-style:italic;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.remove-block{background:var(--red-bg);border:none;color:var(--red);font-size:11px;padding:4px 9px;border-radius:6px;cursor:pointer;font-family:inherit;flex-shrink:0;}

/* Lead status pills */
.status-grid{display:flex;flex-wrap:wrap;gap:6px;}
.status-pill{padding:5px 11px;border-radius:20px;font-size:11px;font-weight:600;cursor:pointer;border:1.5px solid transparent;transition:all .15s;user-select:none;}
.status-pill.on{border-width:2px;font-weight:700;}

/* Validation */
.val-btns{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;}
.val-btn{padding:7px;border-radius:var(--radius-sm);font-size:11px;font-weight:600;cursor:pointer;border:1.5px solid var(--border);background:var(--surface2);color:var(--text2);text-align:center;}
.val-btn.on-valid{background:var(--green-bg);border-color:var(--green);color:var(--green);}
.val-btn.on-invalid{background:var(--red-bg);border-color:var(--red);color:var(--red);}
.val-btn.on-nc{background:var(--amber-bg);border-color:#D97706;color:var(--amber);}

/* Contact blocks */
.contact-block{background:var(--surface2);border:2px solid var(--teal);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px;}
.cb-num{background:var(--teal);color:#fff;font-size:11px;font-weight:700;padding:3px 11px;border-radius:11px;flex-shrink:0;}

/* Agenda blocks */
.agenda-block{background:var(--surface2);border:2px solid var(--green);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px;}
.ab-num{background:var(--green);color:#fff;font-size:11px;font-weight:700;padding:3px 11px;border-radius:11px;flex-shrink:0;}
.type-btns{display:grid;grid-template-columns:1fr 1fr;gap:7px;}
.type-btn{padding:8px;border-radius:var(--radius-sm);font-size:12px;font-weight:600;cursor:pointer;border:1.5px solid var(--border);background:var(--surface2);color:var(--text2);text-align:center;}
.type-btn.on-mtg{background:var(--accent-light);border-color:var(--accent);color:var(--accent);}
.type-btn.on-visit{background:var(--green-bg);border-color:var(--green);color:var(--green);}

/* WA message block */
.wa-block{background:#E8F5E9;border:1.5px solid #A5D6A7;border-radius:var(--radius);padding:13px;margin-bottom:10px;}
.wa-proj-name{font-size:12px;font-weight:700;color:#1B5E20;margin-bottom:7px;}
.wa-textarea{width:100%;min-height:150px;max-height:300px;resize:vertical;font-family:'DM Mono',monospace;font-size:11px;color:#2E7D32;background:#fff;border:1px solid #C8E6C9;border-radius:6px;padding:10px;line-height:1.6;overflow-y:auto;}
.copy-btn-sm{margin-top:7px;width:100%;padding:8px;background:#2E7D32;color:#fff;border:none;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;}

/* Issue cards (open issues panel) */
.issue-card{background:var(--surface2);border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:11px 13px;margin-bottom:9px;}
.issue-card.escalated{border-color:#D97706;background:var(--amber-bg);}
.issue-card.resolved-pending{opacity:.6;}
.ic-top{display:flex;align-items:center;gap:7px;margin-bottom:6px;}
.issue-type-badge{font-size:9px;font-weight:700;padding:2px 7px;border-radius:8px;flex-shrink:0;}
.it-crm{background:rgba(0,95,115,0.12);color:var(--teal);}
.it-design{background:rgba(74,158,255,0.12);color:var(--blue);}
.it-finance{background:rgba(27,122,62,0.12);color:var(--green);}
.it-contractor{background:rgba(255,107,53,0.12);color:var(--red);}
.it-client{background:rgba(168,85,247,0.12);color:#6A1B9A;}
.ic-proj{font-size:10px;color:var(--text3);font-family:'DM Mono',monospace;}
.ic-status{font-size:9px;font-weight:700;padding:2px 7px;border-radius:8px;}
.ics-open{background:rgba(139,32,32,0.1);color:var(--red);}
.ics-esc{background:var(--amber-bg);color:var(--amber);}
.ics-res{background:var(--green-bg);color:var(--green);}
.ic-desc{font-size:12px;color:var(--text);line-height:1.4;margin-bottom:7px;}
.ic-meta{font-size:10px;color:var(--text3);margin-bottom:8px;}
.ic-actions{display:flex;gap:7px;flex-wrap:wrap;}
.ia-btn{font-size:11px;font-weight:700;padding:4px 11px;border-radius:6px;border:1.5px solid;cursor:pointer;font-family:inherit;}
.ia-resolve{background:var(--green-bg);border-color:var(--green);color:var(--green);}
.ia-escalate{background:var(--amber-bg);border-color:#D97706;color:var(--amber);}
.ia-delay{background:var(--blue-bg);border-color:var(--blue);color:var(--blue);}
.ia-btn:disabled{opacity:.4;cursor:not-allowed;}
.delay-row{display:none;margin-top:7px;gap:7px;align-items:center;}
.delay-row.open{display:flex;}

/* New issue blocks */
.new-iss-block{background:#fff;border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:11px;margin-bottom:8px;}
.ni-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;}
.ni-num{background:rgba(0,95,115,0.1);color:var(--teal);font-size:10px;font-weight:700;padding:2px 7px;border-radius:7px;}
.pri-btns{display:flex;gap:5px;}
.pri-btn{flex:1;padding:6px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;border:1.5px solid var(--border);background:var(--surface2);text-align:center;}
.pri-btn.on-1{background:var(--green-bg);border-color:var(--green);color:var(--green);}
.pri-btn.on-2{background:var(--amber-bg);border-color:#D97706;color:var(--amber);}
.pri-btn.on-3{background:var(--red-bg);border-color:var(--red);color:var(--red);}

/* Finance */
.rupee-wrap{position:relative;}
.rupee-wrap::before{content:'₹';position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text2);pointer-events:none;}
.rupee-wrap input{padding-left:24px;}

/* Activity toggles */
.activity-toggle-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);}
.activity-toggle-row:last-of-type{border-bottom:none;}
.atl{font-size:13px;font-weight:500;}
.at-btns{display:flex;gap:6px;}
.at-btn{padding:5px 14px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;border:1.5px solid var(--border);background:var(--surface2);color:var(--text2);}
.at-btn.on-yes{background:var(--green-bg);border-color:var(--green);color:var(--green);}
.at-btn.on-no{background:var(--surface2);border-color:var(--border2);color:var(--text3);}
.activity-detail{display:none;padding-top:10px;}
.activity-detail.open{display:block;}

/* Follow-up card */
.followup-card{background:var(--amber-bg);border:1.5px solid #FFE082;border-radius:var(--radius-sm);padding:11px;margin-bottom:9px;}
.fc-name{font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px;}
.fc-meta{font-size:11px;color:var(--text2);margin-bottom:8px;}

/* Sub-section label */
.sub-lbl{font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.7px;padding-bottom:9px;border-bottom:1px solid var(--border);margin-bottom:12px;}

/* Add buttons */
.add-proj-btn{width:100%;padding:11px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;cursor:pointer;border:2px dashed var(--accent);background:var(--accent-light);color:var(--accent);font-family:inherit;}
.add-proj-btn:hover{background:var(--accent);color:#fff;}
.add-btn{width:100%;padding:8px;border-radius:var(--radius-sm);font-size:12px;font-weight:600;cursor:pointer;border:1.5px dashed var(--border2);background:transparent;color:var(--text2);font-family:inherit;margin-top:4px;}
.add-btn.teal{border-color:var(--teal);color:var(--teal);}
.add-btn.green{border-color:var(--green);color:var(--green);}
.add-btn.blue{border-color:var(--blue);color:var(--blue);}

/* Submit */
.submit-bar{position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--border);padding:11px 18px;display:flex;gap:10px;align-items:center;z-index:50;}
.submit-btn{flex:1;padding:13px;background:var(--accent);color:#fff;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;}
.submit-btn:disabled{opacity:.5;cursor:not-allowed;}
.submit-status{font-size:12px;color:var(--text2);}

/* Success */
.success-screen{display:none;text-align:center;padding:40px 20px;}
.success-icon{font-size:52px;margin-bottom:14px;}
.success-title{font-size:20px;font-weight:700;margin-bottom:8px;color:var(--accent);}
.success-sub{font-size:13px;color:var(--text2);line-height:1.7;}
.new-btn{margin-top:20px;padding:11px 28px;background:var(--accent);color:#fff;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;}

.hidden{display:none;}
.no-issues{text-align:center;padding:20px;color:var(--text3);font-size:13px;}
.resolved-lbl{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.7px;margin:12px 0 8px;padding-top:10px;border-top:1px solid var(--border);}
.toast{position:fixed;top:66px;left:50%;transform:translateX(-50%);background:#333;color:#fff;padding:9px 18px;border-radius:20px;font-size:12px;z-index:999;display:none;}
.divider{border:none;border-top:1px solid var(--border);margin:14px 0;}
</style>
</head>
<body>

<div class="header">
  <img src="https://sidinani14.github.io/DPR/ideaform-logo.png" style="height:26px;filter:brightness(0) invert(1)" onerror="this.style.display='none'">
  <span class="header-title">IDS · <span>CRM Daily Report</span></span>
  <div id="login-area" style="margin-left:auto">
    <div id="g_id_onload"
      data-client_id="48052407111-mantkqn708ejp5otfc34nch2ngl8o9ot.apps.googleusercontent.com"
      data-callback="onGoogleSignIn" data-auto_select="true"></div>
    <div class="g_id_signin" data-type="standard" data-size="small" data-theme="outline" data-shape="pill"></div>
  </div>
  <div id="user-pill" class="user-pill hidden">
    <span class="user-dot"></span><span id="user-name-display">—</span>
  </div>
</div>

<div class="toast" id="toast"></div>
<div class="form-wrap">

  <!-- ── Success ──────────────────────────────── -->
  <div class="success-screen" id="success-screen">
    <div class="success-icon">✅</div>
    <div class="success-title">CRM Report Submitted</div>
    <div class="success-sub" id="success-sub"></div>
    <button class="new-btn" onclick="resetForm()">Submit Another Report</button>
  </div>

  <div id="form-body">

  <!-- ── S0: Open Issues ───────────────────────── -->
  <div class="section">
    <div class="section-head">
      <span class="section-num">!</span>
      <span class="section-title">Open CRM Issues</span>
      <span class="section-badge" id="issues-badge">—</span>
    </div>
    <div class="section-body" id="issues-panel">
      <div class="no-issues">Sign in to load issues…</div>
    </div>
  </div>

  <!-- ── S1: Date ───────────────────────────────── -->
  <div class="section">
    <div class="section-head">
      <span class="section-num">1</span>
      <span class="section-title">Report Date</span>
    </div>
    <div class="section-body">
      <input type="date" id="f-date">
    </div>
  </div>

  <!-- ── S2: Lead Management ───────────────────── -->
  <div class="section">
    <div class="section-head">
      <span class="section-num">2</span>
      <span class="section-title">Lead Management</span>
    </div>
    <div class="section-body">

      <!-- 24-hr follow-up (hidden until data loads) -->
      <div id="followup-wrap" class="hidden">
        <div class="sub-lbl">⏰ 24-hr Follow-up — Yesterday's New Leads</div>
        <div id="followup-list"></div>
        <hr class="divider">
      </div>

      <!-- New leads today -->
      <div class="sub-lbl">➕ New Leads Received Today</div>
      <div id="lead-blocks"></div>
      <button class="add-proj-btn" id="add-lead-btn" onclick="addLeadBlock()" disabled>+ Add New Lead</button>
    </div>
  </div>

  <!-- ── S3: Client Connections Today ─────────── -->
  <div class="section">
    <div class="section-head">
      <span class="section-num">3</span>
      <span class="section-title">Client Connections Today</span>
    </div>
    <div class="section-body">
      <p style="font-size:12px;color:var(--text2);margin-bottom:12px">Log every client contact — calls, WhatsApp, meetings, site visits. Each ongoing project client should be connected at least once a week.</p>
      <div id="contact-blocks"></div>
      <button class="add-btn teal" id="add-contact-btn" onclick="addContactBlock()" disabled>+ Log Client Connection</button>
    </div>
  </div>

  <!-- ── S4: Tomorrow's Plans + Agenda Generator ── -->
  <div class="section">
    <div class="section-head" style="background:#1B5E20">
      <span class="section-num" style="background:rgba(255,255,255,0.2)">4</span>
      <span class="section-title">Tomorrow's Meetings &amp; Site Visits</span>
    </div>
    <div class="section-body">
      <p style="font-size:12px;color:var(--text2);margin-bottom:12px">Plan tomorrow's meetings/visits → agenda auto-generated for project group.</p>
      <div id="agenda-blocks"></div>
      <button class="add-btn green" id="add-agenda-btn" onclick="addAgendaBlock()" disabled>+ Add Meeting / Site Visit</button>
    </div>
  </div>

  <!-- ── S5: Finance ───────────────────────────── -->
  <div class="section">
    <div class="section-head">
      <span class="section-num">5</span>
      <span class="section-title">Finance</span>
    </div>
    <div class="section-body">

      <div class="sub-lbl">Bills Raised Today</div>
      <div class="field-row">
        <div class="field">
          <span class="lbl">No. of Bills</span>
          <input type="number" id="f-bills-count" min="0" placeholder="0">
        </div>
        <div class="field">
          <span class="lbl">Total Amount (₹)</span>
          <div class="rupee-wrap"><input type="number" id="f-bills-amount" min="0" placeholder="0"></div>
        </div>
      </div>
      <div class="field">
        <span class="lbl">Projects Billed <span class="opt">select all that apply</span></span>
        <div class="chips" id="bills-proj-chips"><span style="font-size:12px;color:var(--text3)">Sign in to load projects…</span></div>
      </div>

      <hr class="divider">
      <div class="sub-lbl">Payment Received Today</div>
      <div class="field-row">
        <div class="field">
          <span class="lbl">Amount (₹)</span>
          <div class="rupee-wrap"><input type="number" id="f-pay-amount" min="0" placeholder="0"></div>
        </div>
        <div class="field">
          <span class="lbl">Project</span>
          <select id="f-pay-proj"><option value="">Select project…</option></select>
        </div>
      </div>

      <hr class="divider">
      <div class="sub-lbl">Payment Follow-ups Done Today</div>
      <div class="field">
        <span class="lbl">No. of Follow-ups</span>
        <input type="number" id="f-fup-count" min="0" placeholder="0" style="max-width:120px">
      </div>
      <div class="field">
        <span class="lbl">Projects Followed Up <span class="opt">select all that apply</span></span>
        <div class="chips" id="fup-proj-chips"><span style="font-size:12px;color:var(--text3)">Sign in to load projects…</span></div>
      </div>

    </div>
  </div>

  <!-- ── S6: Other Activities ──────────────────── -->
  <div class="section">
    <div class="section-head">
      <span class="section-num">6</span>
      <span class="section-title">Other Activities</span>
    </div>
    <div class="section-body">

      <!-- Vendor / Contractor Connects -->
      <div class="field">
        <span class="lbl">Vendor / Contractor Connects</span>
        <div class="field-row" style="margin-bottom:8px">
          <div class="field">
            <span class="lbl" style="font-size:10px">Count</span>
            <input type="number" id="f-vendor-count" min="0" placeholder="0" style="max-width:100px">
          </div>
        </div>
        <span class="lbl" style="font-size:10px;margin-bottom:5px;display:block">Projects Involved</span>
        <div class="chips" id="vendor-proj-chips" style="margin-bottom:8px"><span style="font-size:12px;color:var(--text3)">Sign in…</span></div>
        <textarea id="f-vendor-notes" placeholder="Notes on vendor/contractor interactions…" style="min-height:50px"></textarea>
      </div>

      <hr class="divider">

      <!-- TNCP -->
      <div class="field">
        <div class="activity-toggle-row" style="padding-top:0">
          <span class="atl">TNCP Coordination</span>
          <div class="at-btns">
            <div class="at-btn" id="tncp-yes" onclick="setActivity('tncp','yes')">Yes</div>
            <div class="at-btn on-no" id="tncp-no" onclick="setActivity('tncp','no')">No</div>
          </div>
        </div>
        <div class="activity-detail" id="tncp-detail">
