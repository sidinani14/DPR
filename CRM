// ════════════════════════════════════════
// PROJECTS
// ════════════════════════════════════════
async function loadProjects() {
  try {
    const r = await fetch(APPS_SCRIPT_URL,{method:'POST',headers:{'Content-Type':'text/plain'},
      body:JSON.stringify({action:'getLists'})});
    const d = await r.json();
    const EXCL = ['completed','closed','dead','cancelled','proposal','new lead'];
    projects = (d.projects||[]).filter(p=>!EXCL.some(x=>(p.status||'').toLowerCase().includes(x)));
    refreshProjectDropdowns();
    buildChipSets();
  } catch(e){ toast('Could not load projects'); }
}

function refreshProjectDropdowns() {
  const opts = '<option value="">Select project…</option>' +
    projects.map(p=>`<option value="${p.name}">${p.name}</option>`).join('');
  document.getElementById('f-pay-proj').innerHTML = opts;
  document.querySelectorAll('[id^="cb-proj-"],[id^="ag-proj-"],[id^="ni-proj-"]').forEach(sel=>{
    const cur=sel.value; sel.innerHTML=opts; if(cur) sel.value=cur;
  });
}

function buildChipSets() {
  const chipHtml = projects.map(p=>
    `<div class="chip" data-proj="${p.name}" onclick="this.classList.toggle('on')">${p.name}</div>`
  ).join('');
  ['bills-proj-chips','fup-proj-chips','vendor-proj-chips','tncp-proj-chips','quot-proj-chips']
    .forEach(id=>{ const el=document.getElementById(id); if(el) el.innerHTML=chipHtml; });
}

function getChips(id) {
  const el=document.getElementById(id); if(!el) return [];
  return [...el.querySelectorAll('.chip.on')].map(c=>c.dataset.proj||c.textContent);
}

// ════════════════════════════════════════
// OPEN ISSUES — Section 0
// ════════════════════════════════════════
async function loadIssues() {
  document.getElementById('issues-panel').innerHTML='<div class="no-issues">Loading…</div>';
  try {
    const r = await fetch(APPS_SCRIPT_URL,{method:'POST',headers:{'Content-Type':'text/plain'},
      body:JSON.stringify({action:'getAmanIssues', member:crmUser})});
    const d = await r.json();
    renderIssues(d.issues||[]);
  } catch(e) {
    document.getElementById('issues-panel').innerHTML='<div class="no-issues">Could not load issues</div>';
  }
}

function issTypeClass(t) {
  return {'CRM/Process':'it-crm','Design':'it-design','Finance':'it-finance',
          'Contractor':'it-contractor','Client':'it-client'}[t]||'it-crm';
}
function priLabel(p){return p===3?'🔴 High':p===1?'🟢 Low':'🟡 Med';}

function renderIssues(issues) {
  const open = issues.filter(i=>i.status!=='Resolved');
  const res  = issues.filter(i=>i.status==='Resolved');
  document.getElementById('issues-badge').textContent = open.length+' open';
  if(!issues.length){
    document.getElementById('issues-panel').innerHTML='<div class="no-issues">✓ No open issues</div>';
    return;
  }
  let html='';
  [...open].sort((a,b)=>b.priority-a.priority).forEach(iss=>{
    const act=issueActions[iss.issueId];
    const isRes=act?.action==='resolve', isEsc=act?.action==='escalate';
    const sLabel=isRes?'✓ Resolved':isEsc?'🔴 Escalated':iss.status;
    const sCls  =isRes?'ics-res':isEsc?'ics-esc':'ics-open';
    html+=`<div class="issue-card${isEsc?' escalated':''}${isRes?' resolved-pending':''}" id="ic-${iss.issueId}">
      <div class="ic-top">
        <span class="issue-type-badge ${issTypeClass(iss.issueType)}">${iss.issueType}</span>
        <span class="ic-proj">${iss.project}</span>
        <span class="ic-status ${sCls}" style="margin-left:auto">${sLabel}</span>
      </div>
      <div class="ic-desc">${iss.description}</div>
      <div class="ic-meta">${priLabel(iss.priority)} · Target: ${iss.targetDate||'—'} · ${iss.date}${iss.assignedTo?' · → '+iss.assignedTo:''}</div>
      <div class="ic-actions">
        <button class="ia-btn ia-resolve" onclick="issAction('${iss.issueId}','resolve',this)" ${isRes?'disabled':''}>✓ Resolve</button>
        <button class="ia-btn ia-escalate" onclick="issAction('${iss.issueId}','escalate',this)" ${isEsc?'disabled':''}>🔴 Escalate</button>
        <button class="ia-btn ia-delay" onclick="toggleDelay('${iss.issueId}')">📅 Delay</button>
      </div>
      <div class="delay-row" id="dr-${iss.issueId}">
        <input type="date" id="dd-${iss.issueId}" style="flex:1;padding:7px 10px;font-size:12px">
        <button class="ia-btn ia-delay" onclick="issAction('${iss.issueId}','delay',this)">Set Date</button>
      </div>
    </div>`;
  });
  if(res.length){
    html+='<div class="resolved-lbl">Resolved — last 7 days</div>';
    res.forEach(iss=>{
      html+=`<div class="issue-card" style="opacity:.55">
        <div class="ic-top">
          <span class="issue-type-badge ${issTypeClass(iss.issueType)}">${iss.issueType}</span>
          <span class="ic-proj">${iss.project}</span>
          <span class="ic-status ics-res" style="margin-left:auto">✓ Resolved</span>
        </div>
        <div class="ic-desc" style="text-decoration:line-through;color:var(--text3)">${iss.description}</div>
      </div>`;
    });
  }
  document.getElementById('issues-panel').innerHTML=html;
}

function issAction(issueId, action, btn) {
  if(action==='delay'){
    const date=document.getElementById('dd-'+issueId)?.value;
    if(!date){toast('Select a date first');return;}
    issueActions[issueId]={action,targetDate:date};
    toast('New target: '+date);
    document.getElementById('dr-'+issueId).classList.remove('open');
    return;
  }
  issueActions[issueId]={action,targetDate:''};
  const card=document.getElementById('ic-'+issueId);
  if(action==='resolve'){
    card.classList.add('resolved-pending');
    btn.textContent='✓ Resolved'; btn.disabled=true;
    card.querySelector('.ic-status').textContent='✓ Resolved';
    card.querySelector('.ic-status').className='ic-status ics-res';
  } else {
    card.classList.add('escalated');
    btn.textContent='🔴 Escalated'; btn.disabled=true;
    card.querySelector('.ic-status').textContent='🔴 Escalated';
    card.querySelector('.ic-status').className='ic-status ics-esc';
  }
}
function toggleDelay(id){ document.getElementById('dr-'+id).classList.toggle('open'); }

// ════════════════════════════════════════
// YESTERDAY'S LEADS — 24hr follow-up
// ════════════════════════════════════════
async function loadPendingLeads() {
  try {
    const yest = new Date(); yest.setDate(yest.getDate()-1);
    const yStr = yest.toISOString().substring(0,10);
    const r = await fetch(APPS_SCRIPT_URL,{method:'POST',headers:{'Content-Type':'text/plain'},
      body:JSON.stringify({action:'getRecentLeads', date:yStr})});
    const d = await r.json();
    pendingLeads = d.leads||[];
    if(pendingLeads.length){
      renderPendingLeads();
      document.getElementById('followup-wrap').classList.remove('hidden');
    }
  } catch(e){ /* silent */ }
}

function renderPendingLeads() {
  document.getElementById('followup-list').innerHTML = pendingLeads.map((lead,i)=>`
    <div class="followup-card">
      <div class="fc-name">${lead.clientName}</div>
      <div class="fc-meta">${lead.leadStatus} · Added ${lead.date}${lead.leadManager?' · Mgr: '+lead.leadManager:''}</div>
      <span class="lbl" style="font-size:10px">Did you contact this lead today?</span>
      <div class="yn-btns" style="margin-top:5px">
        <div class="yn-btn" id="fu-y-${i}" onclick="setFollowup(${i},'yes')">Yes — Contacted</div>
        <div class="yn-btn on-no" id="fu-n-${i}" onclick="setFollowup(${i},'no')">Not yet</div>
      </div>
      <div id="fu-status-${i}" class="hidden" style="margin-top:8px">
        <span class="lbl" style="font-size:10px">Update Lead Status</span>
        <select id="fu-sel-${i}" style="font-size:12px;margin-top:4px">
          ${LEAD_STATUSES.map(s=>`<option value="${s.key}"${s.key===lead.leadStatus?' selected':''}>${s.key}</option>`).join('')}
        </select>
      </div>
    </div>`).join('');
}

function setFollowup(i, val) {
  document.getElementById('fu-y-'+i).className='yn-btn'+(val==='yes'?' on-yes':'');
  document.getElementById('fu-n-'+i).className='yn-btn'+(val==='no'?' on-no':'');
  document.getElementById('fu-status-'+i).classList.toggle('hidden', val!=='yes');
  pendingLeads[i]._answer = val;
}

