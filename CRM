function setLeadVal(id, val) {
  document.getElementById('lb-val-'+id).value=val;
  document.getElementById('lbv-nc-'+id).className='val-btn'+(val==='Not checked'?' on-nc':'');
  document.getElementById('lbv-v-'+id).className='val-btn'+(val==='Valid'?' on-valid':'');
  document.getElementById('lbv-i-'+id).className='val-btn'+(val==='Invalid'?' on-invalid':'');
}

function setLeadStatus(id, status) {
  document.getElementById('lb-status-'+id).value=status;
  document.getElementById('lb-statgrid-'+id).querySelectorAll('.status-pill').forEach(c=>{
    const s=LEAD_STATUSES.find(x=>x.key===c.dataset.key);
    if(!s) return;
    c.style.borderColor = c.dataset.key===status ? s.color : s.bg;
    c.style.borderWidth = c.dataset.key===status ? '2px' : '1.5px';
    c.style.fontWeight  = c.dataset.key===status ? '700' : '500';
  });
  const lostWrap=document.getElementById('lb-lost-'+id);
  if(lostWrap) lostWrap.style.display=status==='Lost'?'block':'none';
}

