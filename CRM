function addNewIssue() {
  issCount++;
  const id=issCount;
  const div=document.createElement('div');
  div.className='new-iss-block'; div.id='ni-'+id;
  const projOpts='<option value="">Select project…</option>'+
    projects.map(p=>`<option value="${p.name}">${p.name}</option>`).join('');
  const mbrOpts='<option value="">— Not assigned —</option>'+
    TEAM_MEMBERS.map(n=>`<option value="${n}">${n}</option>`).join('');
  div.innerHTML=`
    <div class="ni-header">
      <span class="ni-num">Issue ${id}</span>
      <button style="background:var(--red-bg);border:none;color:var(--red);font-size:11px;padding:3px 8px;border-radius:5px;cursor:pointer" onclick="this.closest('.new-iss-block').remove()">✕</button>
    </div>
    <div class="field" style="margin-bottom:8px">
      <span class="lbl" style="font-size:10px">Type</span>
      <div class="chips">
        ${CRM_ISS_TYPES.map(t=>`<div class="chip" data-type="${t}" onclick="selNIType(this,${id})">${t}</div>`).join('')}
      </div>
      <input type="hidden" id="ni-type-${id}">
    </div>
    <div class="field-row">
      <div class="field">
        <span class="lbl" style="font-size:10px">Project</span>
        <select id="ni-proj-${id}">${projOpts}</select>
      </div>
      <div class="field">
        <span class="lbl" style="font-size:10px">Assign To</span>
        <select id="ni-assign-${id}">${mbrOpts}</select>
      </div>
    </div>
    <textarea id="ni-desc-${id}" placeholder="Describe the issue clearly…" style="min-height:50px;margin-bottom:8px"></textarea>
    <div class="field-row" style="margin-bottom:0">
      <div>
        <span class="lbl" style="font-size:10px;display:block;margin-bottom:4px">Priority</span>
        <div class="pri-btns">
          <div class="pri-btn" id="nip-1-${id}" onclick="setNIPri(${id},1)">Low</div>
          <div class="pri-btn on-2" id="nip-2-${id}" onclick="setNIPri(${id},2)">Med</div>
          <div class="pri-btn" id="nip-3-${id}" onclick="setNIPri(${id},3)">High</div>
        </div>
        <input type="hidden" id="ni-pri-${id}" value="2">
      </div>
      <div>
        <span class="lbl" style="font-size:10px;display:block;margin-bottom:4px">Target Date</span>
        <input type="date" id="ni-tdate-${id}">
      </div>
    </div>`;
  document.getElementById('new-iss-blocks').appendChild(div);
}

function selNIType(el, id) {
  el.closest('.chips').querySelectorAll('.chip').forEach(c=>c.classList.remove('on'));
  el.classList.add('on');
  document.getElementById('ni-type-'+id).value=el.dataset.type;
}

function setNIPri(id, val) {
  [1,2,3].forEach(n=>{
    document.getElementById('nip-'+n+'-'+id).className='pri-btn'+(n===val?' on-'+n:'');
  });
  document.getElementById('ni-pri-'+id).value=val;
}

// ════════════════════════════════════════
// COLLECT
// ════════════════════════════════════════
function collectLeads() {
  const out=[];
  document.querySelectorAll('.lead-block').forEach(b=>{
    const id=b.id.replace('lb-','');
    const nm=(document.getElementById('lb-name-'+id)?.value||'').trim();
    if(!nm) return;
    out.push({
      clientName : nm,
      contactNo  : (document.getElementById('lb-phone-'+id)?.value||'').trim(),
      referredBy : (document.getElementById('lb-ref-'+id)?.value||'').trim(),
      validation : document.getElementById('lb-val-'+id)?.value||'Not checked',
      leadStatus : document.getElementById('lb-status-'+id)?.value||'Not Contacted',
      leadManager: document.getElementById('lb-mgr-'+id)?.value||'',
      remarks    : (document.getElementById('lb-remarks-'+id)?.value||'').trim(),
      lostReasons: (document.getElementById('lb-lostrsn-'+id)?.value||'').trim(),
    });
  });
  return out;
}

function collectFollowups() {
  return pendingLeads
    .filter(l=>l._answer)
    .map((l,i)=>({
      leadId   : l.leadId||'',
      contacted: l._answer==='yes',
      newStatus: l._answer==='yes'
        ? (document.getElementById('fu-sel-'+i)?.value||l.leadStatus)
        : l.leadStatus,
    }));
}

function collectContacts() {
  const out=[];
  document.querySelectorAll('.contact-block').forEach(b=>{
    const id=b.id.replace('cb-','');
    out.push({
      project:(document.getElementById('cb-proj-'+id)?.value||''),
      type   :(document.getElementById('cb-type-'+id)?.value||''),
      notes  :(document.getElementById('cb-notes-'+id)?.value||'').trim(),
    });
  });
  return out;
}

function collectAgendas() {
  const out=[];
  document.querySelectorAll('.agenda-block').forEach(b=>{
    const id=b.id.replace('ab-','');
    out.push({
      project  : document.getElementById('ag-proj-'+id)?.value||'',
      type     : document.getElementById('ag-type-'+id)?.value||'Meeting',
      date     : document.getElementById('ag-date-'+id)?.value||'',
      time     : document.getElementById('ag-time-'+id)?.value||'',
      agenda   : (document.getElementById('ag-agenda-'+id)?.value||'').trim(),
      attendees: (document.getElementById('ag-attendees-'+id)?.value||'').trim(),
      waMsg    : document.getElementById('wa-'+id)?.value||'',
    });
  });
  return out;
}

function collectFinance() {
  return {
    billsCount     : parseInt(document.getElementById('f-bills-count')?.value)||0,
    billsAmount    : parseFloat(document.getElementById('f-bills-amount')?.value)||0,
    billsProjects  : getChips('bills-proj-chips'),
    paymentAmount  : parseFloat(document.getElementById('f-pay-amount')?.value)||0,
    paymentProject : document.getElementById('f-pay-proj')?.value||'',
    followupCount  : parseInt(document.getElementById('f-fup-count')?.value)||0,
    followupProjects: getChips('fup-proj-chips'),
  };
}

function collectOther() {
  const tncpOn=document.getElementById('tncp-yes')?.classList.contains('on-yes');
  const quotOn=document.getElementById('quot-yes')?.classList.contains('on-yes');
  const bniOn =document.getElementById('bni-yes')?.classList.contains('on-yes');
  return {
    vendorCount   : parseInt(document.getElementById('f-vendor-count')?.value)||0,
    vendorProjects: getChips('vendor-proj-chips'),
    vendorNotes   : (document.getElementById('f-vendor-notes')?.value||'').trim(),
    tncp          : tncpOn?'Yes':'No',
    tncpProjects  : tncpOn?getChips('tncp-proj-chips'):[],
    tncpNotes     : tncpOn?(document.getElementById('f-tncp-notes')?.value||'').trim():'',
    quotations    : quotOn?'Yes':'No',
    quotProjects  : quotOn?getChips('quot-proj-chips'):[],
    quotNotes     : quotOn?(document.getElementById('f-quot-notes')?.value||'').trim():'',
    bni           : bniOn?'Yes':'No',
    bniNotes      : bniOn?(document.getElementById('f-bni-notes')?.value||'').trim():'',
  };
}

function collectNewIssues() {
  const out=[];
  document.querySelectorAll('.new-iss-block').forEach(b=>{
    const id=b.id.replace('ni-','');
    const desc=(document.getElementById('ni-desc-'+id)?.value||'').trim();
    if(!desc) return;
    out.push({
      issueType  : document.getElementById('ni-type-'+id)?.value||'CRM/Process',
      project    : document.getElementById('ni-proj-'+id)?.value||'',
      description: desc,
      assignedTo : document.getElementById('ni-assign-'+id)?.value||'',
      priority   : parseInt(document.getElementById('ni-pri-'+id)?.value||2),
      targetDate : document.getElementById('ni-tdate-'+id)?.value||'',
      reportedBy : crmUser,
    });
  });
  return out;
}

// ════════════════════════════════════════
// SUBMIT
// ════════════════════════════════════════
async function submitAll() {
  if(!googleUser){ toast('Sign in first'); return; }
  const date=document.getElementById('f-date')?.value||'';

  document.getElementById('submit-btn').disabled=true;
  document.getElementById('submit-status').textContent='Submitting…';

  try {
    // 1. Issue status updates
    for(const [issueId, act] of Object.entries(issueActions)){
      const newStatus=act.action==='resolve'?'Resolved':act.action==='escalate'?'Escalated':'Open';
      await fetch(APPS_SCRIPT_URL,{method:'POST',headers:{'Content-Type':'text/plain'},
        body:JSON.stringify({action:'updateIssueStatus',issueId,status:newStatus,targetDate:act.targetDate||''})});
    }

    // 2. Main CRM submission
    const leads    = collectLeads();
    const followups= collectFollowups();
    const contacts = collectContacts();
    const agendas  = collectAgendas();
    const finance  = collectFinance();
    const other    = collectOther();
    const newIssues= collectNewIssues();

    const r = await fetch(APPS_SCRIPT_URL,{method:'POST',headers:{'Content-Type':'text/plain'},
      body:JSON.stringify({
        action      : 'submitAmanCRM',
        date, time  : new Date().toTimeString().substring(0,5),
        member      : crmUser,
        newLeads    : JSON.stringify(leads),
        leadFollowups: JSON.stringify(followups),
        contacts    : JSON.stringify(contacts),
        agendas     : JSON.stringify(agendas),
        finance     : JSON.stringify(finance),
        other       : JSON.stringify(other),
        newIssues   : JSON.stringify(newIssues),
      })});
    const resp = await r.json();
    if(resp.status!=='ok') throw new Error(resp.message||'Submission failed');

    // Success screen
    document.getElementById('form-body').style.display='none';
    document.getElementById('success-screen').style.display='block';
    document.querySelector('.submit-bar').style.display='none';

    const issActCount=Object.keys(issueActions).length;
    const billsAmt=finance.billsAmount;
    const payAmt=finance.paymentAmount;
    document.getElementById('success-sub').innerHTML=
      `CRM report submitted by ${crmUser}<br>`+
      (leads.length?`📋 ${leads.length} new lead${leads.length!==1?'s':''} added to LMS<br>`:'')+
      (contacts.length?`📞 ${contacts.length} client connection${contacts.length!==1?'s':''} logged<br>`:'')+
      (agendas.length?`📅 ${agendas.length} meeting agenda${agendas.length!==1?'s':''} ready to send<br>`:'')+
      (billsAmt?`🧾 ₹${billsAmt.toLocaleString('en-IN')} billed today<br>`:'')+
      (payAmt?`💰 ₹${payAmt.toLocaleString('en-IN')} payment received<br>`:'')+
      (newIssues.length?`🚩 ${newIssues.length} issue${newIssues.length!==1?'s':''} logged<br>`:'')+
      (issActCount?`✅ ${issActCount} issue${issActCount!==1?'s':''} updated`:'');

  } catch(e) {
    toast('Error: '+e.message);
    document.getElementById('submit-btn').disabled=false;
    document.getElementById('submit-status').textContent=crmUser;
  }
}

